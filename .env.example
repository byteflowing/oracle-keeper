# oracle-keeper 环境变量模板（docker-compose 用）
# 复制为 .env 后按需修改；所有变量都有合理默认值，可以整个文件留空直接跑。

# ---- 构建 ----
# 镜像仓库；CI 推/拉的都是 ghcr.io/<owner>/oracle-keeper，改默认值或在此覆盖
#IMAGE_REPOSITORY=ghcr.io/ai1888888/oracle-keeper
# Go 模块代理；国内机器建议 https://goproxy.cn,direct
#GOPROXY=https://proxy.golang.org,direct
# 镜像 tag
#IMAGE_TAG=latest

# ---- 挂载 ----
# 数据盘在宿主机上的位置（容器内固定挂到 /data/oracle-keeper）
# 根盘临时目录固定挂载宿主机 /var/tmp/oracle-keeper
#DATA_DIR=/data

# ---- 调度 ----
#TZ=Asia/Shanghai
# 默认随机间隔模式（反指纹）：每轮结束后随机 48-72 分钟跑下一轮，平均每小时一轮
#ORACLE_KEEPER_SCHEDULE_INTERVAL_MIN=48m
#ORACLE_KEEPER_SCHEDULE_INTERVAL_MAX=72m
# 触发后再随机延迟 0..N 分钟
#ORACLE_KEEPER_SCHEDULE_JITTER_MINUTES=2
#ORACLE_KEEPER_SCHEDULE_MAX_RUN_DURATION=45m
# 固定 cron 模式（不推荐，时间指纹明显）；设了此值则忽略上面的间隔配置
#ORACLE_KEEPER_SCHEDULE_SPEC=

# ---- 忙时让路 ----
#ORACLE_KEEPER_BUSY_CPU_PERCENT=40
#ORACLE_KEEPER_BUSY_LOAD_FACTOR=0.8

# ---- CPU ----
#ORACLE_KEEPER_CPU_BURN_DURATION=5m
#ORACLE_KEEPER_CPU_CORES=0
#ORACLE_KEEPER_CPU_DUTY_CYCLE=0.7

# ---- 内存（A1 判据）----
#ORACLE_KEEPER_MEM_ALLOC_PERCENT=30
#ORACLE_KEEPER_MEM_MIN_FREE_PERCENT=25

# ---- 网络 ----
#ORACLE_KEEPER_NET_TOTAL_MB=700
#ORACLE_KEEPER_NET_MAX_PER_HOST_MB=250
#ORACLE_KEEPER_NET_REQUEST_TIMEOUT=5m

# ---- 磁盘 ----
#ORACLE_KEEPER_DISK_WRITE_MB=256
#ORACLE_KEEPER_DISK_MIN_FREE_MB=2048
# 保留模式：文件轮末不删除，占用率高水位时才清理（false = 用完即删）
#ORACLE_KEEPER_DISK_RETAIN_FILES=true
#ORACLE_KEEPER_DISK_PURGE_PERCENT=40

# ---- 日志 ----
#ORACLE_KEEPER_LOG_LEVEL=info
#ORACLE_KEEPER_LOG_FORMAT=json
